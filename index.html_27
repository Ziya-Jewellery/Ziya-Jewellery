<section class="occasion-section">

  <div class="occasion-title">
    <span>🎁</span>
    <h2>Shop by Occasion</h2>
    <p>Find the perfect gift for every special moment</p>
  </div>

  <div class="occasion-scroll">

    <button class="occasion-card"
            type="button"
            data-occasion="Birthday">
      <span>🎂</span>
      <strong>Happy Birthday</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="Anniversary">
      <span>💍</span>
      <strong>Anniversary</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="Surprise">
      <span>🎁</span>
      <strong>Surprise Gift</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="Trending">
      <span>🔥</span>
      <strong>Trending Gift</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="Couple">
      <span>💑</span>
      <strong>Couple Gift</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="Lovers">
      <span>❤️</span>
      <strong>Lovers Gift</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="For Her">
      <span>👩</span>
      <strong>For Her</strong>
    </button>

    <button class="occasion-card"
            type="button"
            data-occasion="For Him">
      <span>👨</span>
      <strong>For Him</strong>
    </button>

  </div>

</section>
/* =====================================================
   SHOP BY OCCASION
   ===================================================== */

.occasion-section {
  width: 100%;
  margin: 25px 0;
  padding: 20px 0;
}

.occasion-title {
  text-align: center;
  margin-bottom: 15px;
}

.occasion-title span {
  font-size: 28px;
}

.occasion-title h2 {
  margin: 5px 0;
  font-size: 22px;
}

.occasion-title p {
  margin: 0;
  font-size: 12px;
  opacity: .7;
}

.occasion-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 8px 15px 15px;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.occasion-scroll::-webkit-scrollbar {
  height: 5px;
}

.occasion-card {
  flex: 0 0 auto;
  width: 135px;
  min-height: 105px;
  padding: 15px 10px;
  border-radius: 16px;
  border: 1px solid #eee;
  background: #fff;
  cursor: pointer;
  text-align: center;
  box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

.occasion-card span {
  display: block;
  font-size: 32px;
  margin-bottom: 8px;
}

.occasion-card strong {
  display: block;
  font-size: 13px;
  line-height: 1.3;
}

.occasion-card:active {
  transform: scale(.96);
}
