<section class="social-section">

  <div class="social-title">
    <span>🌐</span>
    <h2>Connect With Us</h2>
    <p>Follow us and stay connected</p>
  </div>

  <div class="social-scroll">

    <a class="social-card instagram"
       id="socialInstagram"
       href="#"
       target="_blank"
       rel="noopener">
      <span class="social-icon">📸</span>
      <strong>Instagram</strong>
    </a>

    <a class="social-card facebook"
       id="socialFacebook"
       href="#"
       target="_blank"
       rel="noopener">
      <span class="social-icon">📘</span>
      <strong>Facebook</strong>
    </a>

    <a class="social-card youtube"
       id="socialYoutube"
       href="#"
       target="_blank"
       rel="noopener">
      <span class="social-icon">▶️</span>
      <strong>YouTube</strong>
    </a>

    <a class="social-card telegram"
       id="socialTelegram"
       href="#"
       target="_blank"
       rel="noopener">
      <span class="social-icon">✈️</span>
      <strong>Telegram</strong>
    </a>

    <a class="social-card whatsapp"
       id="socialWhatsapp"
       href="#"
       target="_blank"
       rel="noopener">
      <span class="social-icon">💬</span>
      <strong>WhatsApp</strong>
    </a>

  </div>

</section>
/* =====================================================
   SOCIAL MEDIA
   ===================================================== */

.social-section {
  width: 100%;
  margin: 25px 0;
  padding: 20px 0;
}

.social-title {
  text-align: center;
  margin-bottom: 15px;
}

.social-title span {
  font-size: 28px;
}

.social-title h2 {
  margin: 5px 0;
  font-size: 22px;
}

.social-title p {
  margin: 0;
  font-size: 12px;
  opacity: .7;
}

.social-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 8px 15px 15px;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.social-scroll::-webkit-scrollbar {
  height: 5px;
}

.social-card {
  flex: 0 0 auto;
  width: 125px;
  min-height: 105px;
  padding: 15px 10px;
  border-radius: 16px;
  border: 1px solid #eee;
  background: #fff;
  text-align: center;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

.social-icon {
  display: block;
  font-size: 34px;
  margin-bottom: 8px;
}

.social-card strong {
  display: block;
  font-size: 13px;
}

.social-card:active {
  transform: scale(.96);
}
const links={
  whatsapp: whatsappNumber
    ? getWhatsAppHref(
        encodeURIComponent(
          "Hello Ziya Jewellery, I need help."
        )
      )
    : "#whatsapp-config",

  instagram: cleanUrl(
    siteSettings.instagram
  ),

  facebook: cleanUrl(
    siteSettings.facebook
  ),

  youtube: cleanUrl(
    siteSettings.youtube
  ),

  telegram: cleanUrl(
    siteSettings.telegram
  ),

  x: cleanUrl(
    siteSettings.x ||
    siteSettings.twitter
  )
};
