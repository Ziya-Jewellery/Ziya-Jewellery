.delivery-partners-section {
  width: 100%;
  margin: 25px 0;
  padding: 22px 0;
  text-align: center;
}

.delivery-partners-title span {
  font-size: 28px;
}

.delivery-partners-title h2 {
  margin: 5px 0;
  font-size: 22px;
}

.delivery-partners-title p {
  margin: 0 0 15px;
  font-size: 12px;
  opacity: .7;
}

.delivery-partners-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 8px 15px 15px;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.delivery-partners-scroll::-webkit-scrollbar {
  height: 5px;
}

