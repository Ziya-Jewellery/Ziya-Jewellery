  flex: 0 0 145px;
  min-height: 90px;
  padding: 14px 10px;
  border-radius: 16px;
  background: #fff;
  border: 1px solid #eee;
  box-shadow: 0 3px 12px rgba(0,0,0,.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.delivery-partner-card span {
  font-size: 28px;
  margin-bottom: 6px;
}

.delivery-partner-card strong {
  font-size: 12px;
}

