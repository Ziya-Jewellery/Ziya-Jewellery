<section class="delivery-partners-section">

  <div class="delivery-partners-title">
    <span>🚚</span>
    <h2>Delivery Partners</h2>
    <p>Delivery partner may vary depending on destination and availability.</p>
  </div>

  <div class="delivery-partners-scroll">

    <div class="delivery-partner-card">
      <strong>Blue Dart</strong>
      <small>India</small>
    </div>

    <div class="delivery-partner-card">
      <strong>Delhivery</strong>
      <small>India</small>
    </div>

    <div class="delivery-partner-card">
      <strong>Ecom Express</strong>
      <small>India</small>
    </div>

    <div class="delivery-partner-card">
      <strong>DTDC</strong>
      <small>India</small>
    </div>

    <div class="delivery-partner-card">
      <strong>DHL Express</strong>
      <small>International</small>
    </div>

    <div class="delivery-partner-card">
      <strong>FedEx</strong>
      <small>International</small>
    </div>

    <div class="delivery-partner-card">
      <strong>UPS</strong>
      <small>International</small>
    </div>

    <div class="delivery-partner-card">
      <strong>Aramex</strong>
      <small>International</small>
    </div>

    <div class="delivery-partner-card">
      <strong>Ship Global</strong>
      <small>International</small>
    </div>

  </div>

</section>
/* =====================================================
   DELIVERY PARTNERS
   ===================================================== */

.delivery-partners-section {
  width: 100%;
  margin: 25px 0;
  padding: 20px 0;
}

.delivery-partners-title {
  text-align: center;
  margin-bottom: 15px;
}

.delivery-partners-title span {
  font-size: 28px;
}

.delivery-partners-title h2 {
  margin: 5px 0;
  font-size: 22px;
}

.delivery-partners-title p {
  margin: 0;
  font-size: 12px;
  opacity: 0.7;
}

.delivery-partners-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 8px 15px 15px;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.delivery-partners-scroll::-webkit-scrollbar {
  height: 5px;
}

.delivery-partner-card {
  flex: 0 0 auto;
  min-width: 135px;
  padding: 14px 16px;
  border-radius: 14px;
  text-align: center;
  background: #fff;
  border: 1px solid #eee;
  box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

.delivery-partner-card strong {
  display: block;
  font-size: 15px;
}

.delivery-partner-card small {
  display: block;
  margin-top: 5px;
  font-size: 11px;
  opacity: .65;
}
