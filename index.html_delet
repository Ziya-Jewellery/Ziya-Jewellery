<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#7b1e4a">
<title>Ziya Jewellery</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#fff8fb;color:#2b1b22}
header{padding:22px 16px;text-align:center;background:linear-gradient(135deg,#7b1e4a,#d66b9b);color:#fff}
header h1{margin:0;font-size:28px}header p{margin:7px 0 0;font-size:13px;opacity:.9}
section{width:100%;margin:25px 0;padding:20px 0}
.title{text-align:center;margin-bottom:15px}.title span{font-size:28px}.title h2{margin:5px 0;font-size:22px}.title p{margin:0;font-size:12px;opacity:.7}
.scroll{display:flex;gap:12px;overflow-x:auto;padding:8px 15px 15px;scroll-behavior:smooth;-webkit-overflow-scrolling:touch}
.scroll::-webkit-scrollbar{height:5px}
.card{flex:0 0 auto;width:140px;min-height:105px;padding:15px 10px;border-radius:16px;border:1px solid #eee;background:#fff;text-align:center;box-shadow:0 3px 12px rgba(0,0,0,.08)}
.card span{display:block;font-size:32px;margin-bottom:8px}.card strong{display:block;font-size:13px;line-height:1.3}
button.card{cursor:pointer;color:inherit;font-family:inherit}
.social{width:125px;min-height:105px;text-decoration:none;color:inherit}.social-icon{display:block;font-size:34px;margin-bottom:8px}
.delivery{width:145px;min-height:90px}.delivery span{font-size:28px}
footer{text-align:center;padding:24px 15px;background:#2b1b22;color:#fff;font-size:12px}
.notice{margin:15px;border-radius:14px;padding:12px;text-align:center;background:#fff0f6;font-size:13px}
</style>
</head>
<body>
<header><h1>💎 Ziya Jewellery</h1><p>Beautiful jewellery &amp; gifts for every special moment</p></header>

<div class="notice">✨ Welcome to Ziya Jewellery ✨</div>

<section>
<div class="title"><span>🎁</span><h2>Shop by Occasion</h2><p>Find the perfect gift for every special moment</p></div>
<div class="scroll">
<button class="card" data-occasion="Birthday"><span>🎂</span><strong>Happy Birthday</strong></button>
<button class="card" data-occasion="Anniversary"><span>💍</span><strong>Anniversary</strong></button>
<button class="card" data-occasion="Surprise"><span>🎁</span><strong>Surprise Gift</strong></button>
<button class="card" data-occasion="Trending"><span>🔥</span><strong>Trending Gift</strong></button>
<button class="card" data-occasion="Couple"><span>💑</span><strong>Couple Gift</strong></button>
<button class="card" data-occasion="Lovers"><span>❤️</span><strong>Lovers Gift</strong></button>
<button class="card" data-occasion="For Her"><span>👩</span><strong>For Her</strong></button>
<button class="card" data-occasion="For Him"><span>👨</span><strong>For Him</strong></button>
</div>
</section>

<section>
<div class="title"><span>🌐</span><h2>Connect With Us</h2><p>Follow us and stay connected</p></div>
<div class="scroll">
<a class="card social" id="socialInstagram" href="#" target="_blank" rel="noopener"><span class="social-icon">📸</span><strong>Instagram</strong></a>
<a class="card social" id="socialFacebook" href="#" target="_blank" rel="noopener"><span class="social-icon">📘</span><strong>Facebook</strong></a>
<a class="card social" id="socialYoutube" href="#" target="_blank" rel="noopener"><span class="social-icon">▶️</span><strong>YouTube</strong></a>
<a class="card social" id="socialTelegram" href="#" target="_blank" rel="noopener"><span class="social-icon">✈️</span><strong>Telegram</strong></a>
<a class="card social" id="socialWhatsapp" href="#" target="_blank" rel="noopener"><span class="social-icon">💬</span><strong>WhatsApp</strong></a>
</div>
</section>

<section>
<div class="title"><span>📦</span><h2>Our Delivery Partners</h2><p>Trusted delivery support for your orders</p></div>
<div class="scroll">
<div class="card delivery"><span>🚚</span><strong>Blue Dart Express</strong><small>India</small></div>
<div class="card delivery"><span>📦</span><strong>Ecom Express</strong><small>India</small></div>
<div class="card delivery"><span>🚛</span><strong>Delhivery</strong><small>India</small></div>
<div class="card delivery"><span>✈️</span><strong>Ship Global</strong><small>International</small></div>
<div class="card delivery"><span>🌍</span><strong>Aramex</strong><small>International</small></div>
<div class="card delivery"><span>🌐</span><strong>DHL Express</strong><small>International</small></div>
</div>
</section>

<footer>© 2026 Ziya Jewellery — All Rights Reserved</footer>

<script>
document.querySelectorAll("[data-occasion]").forEach(function(btn){
  btn.addEventListener("click",function(){
    alert("Showing gifts for: "+this.dataset.occasion);
  });
});
</script>
</body>
</html>
